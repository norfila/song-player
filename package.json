{
  "name": "song-player",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:ui": "node --test --test-isolation=none src/lib/state.test.mjs src/lib/shortcuts.test.mjs src/lib/theme.test.mjs src/lib/settings-transfer.test.mjs src/lib/volume-wheel.test.mjs src/lib/power-search.test.mjs src/lib/library-paths.test.mjs src/lib/waveform.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "test:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "i18next": "^25.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
